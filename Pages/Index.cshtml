@page
@model IndexModel

@{
    ViewData["Title"] = "Home page";
}

<div class="w-screen">
    <div class="flex">
        <div class="bg-slate-300 p-[10px] m-[20px] rounded-lg">
            <p class="font-bold">Filters:</p>
            <form>
                <p>Service to filter:</p>
                <input type="text" name="serviceFilter" value="@Model.ServiceFilter"/>
                <p>Customer Id to filter:</p>
                <input type="number" name="customerFilter" value="@Model.CustomerFilter" />
                <p></p>
                <input type="checkbox" id="tempHireFilter" name="rfFilter" value="temphire" checked=@Model.RfFilterTempHire />
                <label for="tempHireFilter">Include rf in temporary worker numbers</label>
                <p></p>
                <input type="checkbox" id="relationFilter" name="rfFilter" value="relation" checked="@Model.RfFilterRelation" />
                <label for="relationFilter">Include rf in relation numbers</label>
                <p></p>
                <button class="p-[3px] bg-slate-100 rounded-lg">apply filters</button>
            </form>
        </div>
        <div class="bg-slate-200 rounded-lg p-[10px] m-[20px] box-shadow">
            <p class="font-bold">Show average calls per day</p>
            <canvas class="h-full" id="callsChart"></canvas> 
        </div>
    </div>
    <div class="flex">
        <div class="bg-slate-200 rounded-lg p-[10px] m-[20px]">
            <p class="font-bold">Comparison between external and internal customers:</p>
            <!-- Canvas for the pie chart showing internal vs external customers -->
            <canvas id="customersChart"></canvas>
        </div>
        <div class="bg-slate-200 rounded-lg p-[10px] m-[20px]">
            <p class="font-bold">Comparison between thee different levels of calls</p>
            <canvas id="levelsChart"></canvas>
        </div>
    </div>
</div>

<script>
    new Chart(document.getElementById('callsChart'), {
    type: 'line',
    data: {
    labels: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    datasets: [{
    label: 'Average calls',
    data: [
    @Model.CallsPerDay[1],
    @Model.CallsPerDay[2],
    @Model.CallsPerDay[3],
    @Model.CallsPerDay[4],
    @Model.CallsPerDay[5],
    @Model.CallsPerDay[6],
    @Model.CallsPerDay[0]
    ],
    borderColor: 'DarkGray',
    backgroundColor: 'transparent'
    }]
    }
    });
</script> 
<!-- Pie chart for internal vs external customers -->
<script>
    new Chart(document.getElementById('customersChart'), {
    type: 'pie',
    data: {
    labels: ['Internal customers', 'External customers'],
    datasets: [{
    data: [
    @Model.InternalCustomers,
    @Model.ExternalCustomer
    ],
    backgroundColor: ['#378ADD', '#1D9E75']
    }]
    }
    });
</script>
<!-- Pie chart for different levels of calls -->
<script>
    new Chart(document.getElementById('levelsChart'), {
    type: 'pie',
    data: {
    labels: ['Managing level', 'Relation level', 'Temporary worker level'],
    datasets: [{
    data: [
    @Model.ManagingLevel,
    @Model.RelationLevel,
    @Model.TempHireLevel
    ],
    backgroundColor: ['#378ADD', '#1D9E75', '#85B7EB']
    }]
    }
    });
</script>