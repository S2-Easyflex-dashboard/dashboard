@page
@model dashboard.Pages.ExtCompList
@{
    ViewData["Title"] = "List of external companies";
}

<div class="w-screen p-[20px]">
    <h1 class="font-bold mb-3">List of ip adresses used by multiple customers:</h1>
    <table class="w-full bg-slate-300 rounded-lg">
        <tr class="text-left">
            <th class="p-3">Ip:</th>
            <th class="p-3">Amount:</th>
            <th class="p-3">User id's:</th>
        </tr>
        @foreach(var ip in Model.DuplicateIps){
            <tr>
                <td class="p-3">@ip.Ip</td>
                <td class="p-3">@ip.Amount</td>
                <td class="p-3">
                    @ip.CustomerIds[0]
                    @{
                        ip.CustomerIds.RemoveAt(0);
                    }
                    @foreach (var user in ip.CustomerIds)
                    {
                        <span>, @user</span>
                    }
                </td>
            </tr>
        }
    </table>
</div>