@model IndexViewModel

<div class="p-6 space-y-6">
    <div class="flex gap-6">

        <div class="bg-white border border-gray-200 rounded-xl p-5 w-80 shrink-0">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">Filters</p>
            <form method="get">
                <label class="block text-sm text-gray-600 mb-1" for="ServiceFilter">Service om te filteren</label>
                <input type="text" id="ServiceFilter" name="ServiceFilter" value="@Model.ServiceFilter"
                       class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:border-blue-500" />

                <label class="block text-sm text-gray-600 mt-3 mb-1" for="KlantFilter">Klant ID om te filteren</label>
                <input type="number" id="KlantFilter" name="KlantFilter" value="@Model.CustomerFilter"
                       class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-gray-50 focus:outline-none focus:border-blue-500" />

                <div class="flex items-center gap-2 mt-4">
                    <input type="checkbox" id="tempHireFilter" name="rfFilter" value="temphire" checked=@Model.RfFilterTempHire
                           @(Model.RfFilterTempHire ? "checked" : "")
                           class="w-4 h-4 accent-blue-600" />
                    <label for="tempHireFilter" class="text-sm text-gray-600">Neem RF mee in tijdelijke werknummers</label>
                </div>

                <div class="flex items-center gap-2 mt-2">
                    <input type="checkbox" id="relationFilter" name="rfFilter" value="relation" checked="@Model.RfFilterRelation"
                           @(Model.RfFilterRelation ? "checked" : "")
                           class="w-4 h-4 accent-blue-600" />
                    <label for="relationFilter" class="text-sm text-gray-600">Neem RF mee in relatienummers</label>
                </div>

                <button type="submit" class="mt-4 w-full py-2 px-4 bg-blue-800 hover:bg-blue-700 text-white text-sm font-medium rounded-lg">
                    Pas filter toe
                </button>
            </form>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl p-5 flex-1">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Gemiddeld aantal oproepen per dag</p>
            <div class="flex gap-3 mb-3">
                <span class="flex items-center gap-1.5 text-xs text-gray-500">
                    <span class="w-2.5 h-2.5 rounded-sm bg-blue-500 inline-block"></span>
                    Gemiddelde oproepen
                </span>
            </div>
            <div class="relative h-56">
                <canvas id="lineChart" role="img" aria-label="Lijndiagram oproepen per dag"></canvas>
            </div>
        </div>
    </div>

    <div class="flex gap-6">

        <div class="bg-white border border-gray-200 rounded-xl p-5 flex-1">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Vergelijking externe vs interne klanten</p>
            <div class="relative h-56 max-w-xs mx-auto">
                <canvas id="customersChart" role="img" aria-label="Taartdiagram interne vs externe klanten"></canvas>
            </div>
            <div class="flex flex-wrap justify-center gap-4 mt-3">
                <span class="flex items-center gap-1.5 text-xs text-gray-500">
                    <span class="w-2.5 h-2.5 rounded-sm bg-blue-500 inline-block"></span>
                    Interne klanten
                </span>
                <span class="flex items-center gap-1.5 text-xs text-gray-500">
                    <span class="w-2.5 h-2.5 rounded-sm bg-[#1d9e75] inline-block" ></span>
                    Externe klanten
                </span>
            </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl p-5 flex-1">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Vergelijking oproepniveaus</p>
            <div class="relative h-56 max-w-xs mx-auto">
                <canvas id="pieChart2" role="img" aria-label="Taartdiagram oproepniveaus"></canvas>
            </div>
            <div class="flex flex-wrap justify-center gap-4 mt-3">
                <span class="flex items-center gap-1.5 text-xs text-gray-500">
                    <span class="w-2.5 h-2.5 rounded-sm bg-blue-500 inline-block"></span>
                    Management
                </span>
                <span class="flex items-center gap-1.5 text-xs text-gray-500">
                    <span class="w-2.5 h-2.5 rounded-sm inline-block" style="background:#1d9e75"></span>
                    Relatie
                </span>
                <span class="flex items-center gap-1.5 text-xs text-gray-500">
                    <span class="w-2.5 h-2.5 rounded-sm bg-blue-300 inline-block"></span>
                    Tijdelijk
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
    new Chart(document.getElementById('lineChart'), {
        type: 'line',
        data: {
            labels: ['Maandag', 'Dinsdag', 'Woensdag', 'Donderdag', 'Vrijdag', 'Zaterdag', 'Zondag'],
            datasets: [{
                label: 'Gemiddelde oproepen',
                data: [
                    @Model.CallsPerDay[1],
                    @Model.CallsPerDay[2],
                    @Model.CallsPerDay[3],
                    @Model.CallsPerDay[4],
                    @Model.CallsPerDay[5],
                    @Model.CallsPerDay[6],
                    @Model.CallsPerDay[0]
                ],
                borderColor: '#3b82f6',
                backgroundColor: 'rgba(59,130,246,0.08)',
                borderWidth: 2,
                pointBackgroundColor: '#3b82f6',
                pointRadius: 4,
                tension: 0.35,
                fill: true
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: {
                    ticks: { callback: v => v.toLocaleString('nl-NL'), font: { size: 11 }, color: '#6b7280' },
                    grid: { color: 'rgba(0,0,0,0.06)' },
                    border: { display: false }
                },
                x: {
                    ticks: { font: { size: 11 }, color: '#6b7280' },
                    grid: { display: false },
                    border: { display: false }
                }
            }
        }
    });

    const pieOptions = {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '42%',
        plugins: { legend: { display: false } }
    };

    new Chart(document.getElementById('customersChart'), {
        type: 'doughnut',
        data: {
            labels: ['Interne klanten', 'Externe klanten'],
            datasets: [{
                data: [@Model.InternalCustomers, @Model.ExternalCustomer],
                backgroundColor: ['#3b82f6', '#1d9e75'],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: pieOptions
    });

    new Chart(document.getElementById('pieChart2'), {
        type: 'doughnut',
        data: {
            labels: ['Management niveau', 'Relatie niveau', 'Tijdelijke werker niveau'],
            datasets: [{
                data: [@Model.ManagingLevel, @Model.RelationLevel, @Model.TempHireLevel],
                backgroundColor: ['#3b82f6', '#1d9e75', '#93c5fd'],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: pieOptions
    });
</script>
}